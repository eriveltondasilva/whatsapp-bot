generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks", "prismaSchemaFolder", "multiSchema"]
  output          = "../src/generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
