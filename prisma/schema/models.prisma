model WorkingHour {
  id Int @id @default(autoincrement())

  dayOfWeek   Int     @map("day_of_week") @db.SmallInt
  openingTime String  @map("opening_time") @db.VarChar(8)
  closingTime String  @map("closing_time") @db.VarChar(8)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("working_hours")
}

model Pizzeria {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  cnpj        String? @unique @db.VarChar(20)
  address     String? @db.VarChar(255)
  phone       String? @unique @db.VarChar(20)
  isActive    Boolean @default(true) @map("is_active")

  deliveryTax   Decimal? @default(0.00) @map("delivery_tax") @db.Decimal(10, 2)
  minOrderValue Decimal? @default(0.00) @map("min_order_value") @db.Decimal(10, 2)

  website   String? @db.VarChar(100)
  instagram String? @db.VarChar(100)
  facebook  String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pizzerias")
}
