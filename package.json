{
  "name": "whatsapp-bot",
  "description": "",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Erivelton Silva <eriveltondasilva13@gmail.com> (https://github.com/eriveltondasilva)",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",

    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx --env-file=.env -r tsconfig-paths/register src/index.ts",
    "dev:watch": "tsx --env-file=.env -r tsconfig-paths/register -w src/index.ts",

    "fmt": "biome format --verbose .",
    "fmt:fix": "biome format --fix --verbose .",

    "lint": "biome lint --unsafe --verbose .",
    "lint:fix": "biome lint --fix --unsafe --verbose .",

    "check": "biome check --unsafe --verbose .",
    "check:fix": "biome check --fix --unsafe --verbose .",

    "type:check": "tsc --noEmit",

    "db:migrate": "npx prisma migrate dev --name",
    "db:reset": "npx prisma migrate reset",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",

    "test": "vitest run tests"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts",
    "schema": "./prisma/schema"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@wppconnect-team/wppconnect": "^1.35.2",
    "dayjs": "^1.11.13",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.5",
    "prisma": "^6.3.1",
    "prisma-dbml-generator": "^0.12.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "tsyringe": "^4.8.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.2"
  }
}
